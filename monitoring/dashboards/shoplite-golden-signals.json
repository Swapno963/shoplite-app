          "legendFormat": "p99 {{route}}",
          "refId": "C"
        }
      ],
      "title": "Request latency per route (p50 / p95 / p99)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
