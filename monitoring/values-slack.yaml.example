# Standalone kube-prometheus-stack overlay (not the umbrella).
# Copy to monitoring/values-slack.yaml (gitignored).
# helm upgrade kube-prometheus-stack ... -f kube-prometheus-stack-values.yaml -f values-slack.yaml

alertmanager:
  config:
    receivers:
      - name: slack-notifications
        slack_configs:
          - api_url: "https://hooks.slack.com/services/REPLACE_ME"
            channel: "#shoplite-alerts"
            send_resolved: true
            title: "{{ .Status | toUpper }} - {{ .CommonLabels.alertname }}"
            text: |-
              {{ range .Alerts }}
              *Alert:* {{ .Annotations.summary }}
              *Description:* {{ .Annotations.description }}
              *Severity:* {{ .Labels.severity }}
              *Runbook:* {{ .Annotations.runbook_url }}
              {{ end }}
